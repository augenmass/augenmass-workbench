{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "augenmass-cache",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-24",
  "containers": [
    {
      "class_name": "AugenmassCacheContainer",
      "image": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUGENMASS_CACHE_CONTAINER",
        "class_name": "AugenmassCacheContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AugenmassCacheContainer"]
    }
  ],
  "vars": {
    "AUGENMASS_CACHE_ALLOWED_RPS": "2af138a8-59ea-4a84-aea3-666cafdb1369",
    "AUGENMASS_CACHE_MAX_ENTRIES": "512",
    "AUGENMASS_CACHE_TIMEOUT_SECS": "10",
    "AUGENMASS_CACHE_TTL_SECS": "3600",
    "AUGENMASS_CACHE_UPSTREAM": "https://sandbox.eudi-wallet.org/api"
  }
}
