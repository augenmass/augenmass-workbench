#!/usr/bin/env sh
set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

print_unsigned_help() {
  platform="$1"
  cat >&2 <<EOF

Augenmass could not run the selected binary.

These bundled binaries may not be signed/notarized yet. Do not bypass OS security
blindly: verify the release/checksum first, then either approve the binary
manually or build from source and set AUGENMASS_BIN.
EOF

  case "${platform}" in
    macos)
      cat >&2 <<EOF

macOS manual approval:
  1. Try running the command once.
  2. Open System Settings -> Privacy & Security.
  3. Scroll to Security and click Open Anyway for Augenmass.
  4. Run the command again.
EOF
      ;;
    linux)
      cat >&2 <<EOF

Linux executable-bit fix:
  chmod +x "${candidate}"
EOF
      ;;
    windows)
      cat >&2 <<EOF

Windows manual approval:
  Right-click augenmass.exe -> Properties -> Unblock, or after verifying it:
  Unblock-File .\\augenmass.exe
EOF
      ;;
  esac

  cat >&2 <<EOF

Source build fallback:
  cargo build --release --locked
  export AUGENMASS_BIN=/path/to/target/release/augenmass
EOF
}

if [ -n "${AUGENMASS_BIN:-}" ]; then
  candidate="${AUGENMASS_BIN}"
  platform="override"
else
  uname_s=$(uname -s 2>/dev/null || printf unknown)
  uname_m=$(uname -m 2>/dev/null || printf unknown)
  platform="unknown"
  target=""
  binary="augenmass"

  case "${uname_s}:${uname_m}" in
    Darwin:arm64 | Darwin:aarch64)
      target="aarch64-apple-darwin"
      platform="macos"
      ;;
    Darwin:x86_64 | Darwin:amd64)
      target="x86_64-apple-darwin"
      platform="macos"
      ;;
    Linux:x86_64 | Linux:amd64)
      target="x86_64-unknown-linux-gnu"
      platform="linux"
      ;;
    MINGW*:x86_64 | MSYS*:x86_64 | CYGWIN*:x86_64)
      target="x86_64-pc-windows-msvc"
      platform="windows"
      binary="augenmass.exe"
      ;;
    *)
      cat >&2 <<EOF
Unsupported Augenmass bundled platform: ${uname_s}/${uname_m}

Install a native release archive or build from source, then set AUGENMASS_BIN
to the trusted binary path.
EOF
      exit 127
      ;;
  esac

  candidate="${script_dir}/${target}/${binary}"
fi

if [ ! -f "${candidate}" ]; then
  cat >&2 <<EOF
Missing Augenmass binary: ${candidate}

Install a native release archive or rebuild the plugin bundle, then set
AUGENMASS_BIN if you want to use a specific trusted binary.
EOF
  exit 127
fi

if [ "${candidate##*.}" != "exe" ] && [ ! -x "${candidate}" ]; then
  print_unsigned_help "${platform}"
  exit 126
fi

"${candidate}" "$@"
status=$?
if [ "${status}" -eq 126 ] || [ "${status}" -eq 127 ]; then
  print_unsigned_help "${platform}"
fi
exit "${status}"
