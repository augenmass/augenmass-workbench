# Augenmass Workbench configuration. Copy to .env and fill in only what you need.
# Static artifact commands run fully offline with no config. Configure only the
# explicit live targets you use.

# Shared HTTP timeout for CLI live calls such as list, register, sandbox token
# exchange, and cache warm.
AUGENMASS_HTTP_TIMEOUT_SECS=10

# --- Local clone target (the safe default for `register`/`list`) ---
# Where `clone serve` listens and where `--target clone` writes/reads.
AUGENMASS_CLONE_API_BASE=http://127.0.0.1:8080/api

# --- Cached sandbox target (read-only mirror for public sandbox GET routes) ---
# Where `cache serve` listens and where `--target cached-sandbox` reads.
AUGENMASS_CACHE_API_BASE=http://127.0.0.1:8081/api
# Server settings for `cache serve`. Railway and similar platforms may set PORT;
# the CLI uses AUGENMASS_CACHE_PORT first, then PORT, then 8081.
AUGENMASS_CACHE_DB=./augenmass-cache.sqlite
AUGENMASS_CACHE_HOST=127.0.0.1
AUGENMASS_CACHE_PORT=8081
AUGENMASS_CACHE_UPSTREAM=https://sandbox.eudi-wallet.org/api
AUGENMASS_CACHE_TTL_SECS=3600
AUGENMASS_CACHE_TIMEOUT_SECS=10
AUGENMASS_CACHE_MAX_ENTRIES=512
# Registration-certificate read-through is bounded to known RPs. Add more as a
# comma-separated list when a demo or audit needs them.
AUGENMASS_CACHE_ALLOWED_RPS=2af138a8-59ea-4a84-aea3-666cafdb1369
# Shared deployments must keep an allowlist. Set this only for isolated
# development mirrors where any syntactically valid RP may be read through.
AUGENMASS_CACHE_ALLOW_ANY_RP=0
# Public binds require an https upstream without credentials, query, fragment,
# or private IP host. Set this only for isolated development.
AUGENMASS_CACHE_UNSAFE_UPSTREAM=0
# Optional for loopback. Required when AUGENMASS_CACHE_HOST is non-loopback
# such as 0.0.0.0. When set, /api/cache/status and /api/cache/refresh require
# Authorization: Bearer <token> or x-augenmass-cache-admin: <token>.
AUGENMASS_CACHE_ADMIN_TOKEN=

# --- Public sandbox snapshot (no credentials, presentation/website prep) ---
AUGENMASS_PUBLIC_SANDBOX_API_BASE=https://sandbox.eudi-wallet.org/api
AUGENMASS_PUBLIC_SANDBOX_RP=2af138a8-59ea-4a84-aea3-666cafdb1369
AUGENMASS_PUBLIC_SANDBOX_TIMEOUT_SECS=30
AUGENMASS_PUBLIC_SANDBOX_MAX_BYTES=5242880
# Fail if the configured RP returns zero public registration certificates.
AUGENMASS_PUBLIC_SANDBOX_REQUIRE_RP=1
# Optional redacted aggregate JSON summary; omits registration JWT/CWT bodies.
AUGENMASS_PUBLIC_SANDBOX_SNAPSHOT_JSON=

# --- Sandbox registrar (only for `--target sandbox`, a rehearsal path) ---
# The real registrar API base. Falls back to API_BASE, then a built-in default.
AUGENMASS_API_BASE=https://sandbox.eudi-wallet.org/api
# Keycloak OAuth resource-owner password grant. The working client_id is `swagger`
# (hardcoded in the client); a project-specific client_id fails with invalid_client.
AUGENMASS_OIDC_TOKEN_URL=
AUGENMASS_USERNAME=
AUGENMASS_PASSWORD=
# Optional; sent only when set.
AUGENMASS_OIDC_CLIENT_SECRET=
# Sandbox API and token URLs must be https and must not include URL userinfo,
# query strings, or fragments. Set this only for loopback development.
AUGENMASS_UNSAFE_SANDBOX_URLS=0
