# Augenmass Workbench configuration. Copy to .env and fill in only what you need.
# Everything except the registrar write path runs fully offline with no config.

# --- Local clone target (the safe default for `register`/`list`) ---
# Where `clone serve` listens and where `--target clone` writes/reads.
AUGENMASS_CLONE_API_BASE=http://127.0.0.1:8080/api

# --- Sandbox registrar (only for `--target sandbox`, a rehearsal path) ---
# The real registrar API base. Falls back to API_BASE, then a built-in default.
AUGENMASS_API_BASE=https://sandbox.eudi-wallet.org/api
# Keycloak OAuth resource-owner password grant. The working client_id is `swagger`
# (hardcoded in the client); a project-specific client_id fails with invalid_client.
AUGENMASS_OIDC_TOKEN_URL=
AUGENMASS_USERNAME=
AUGENMASS_PASSWORD=
# Optional; sent only when set.
AUGENMASS_OIDC_CLIENT_SECRET=
